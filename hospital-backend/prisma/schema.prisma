// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
  url      = "postgresql://postgres:123@localhost:5433/hospital_db"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  gender       Gender
  cnic         String   @unique @db.VarChar(15)
  createdAt    DateTime @default(now()) @map("created_at")
  registeredAt DateTime @default(now()) @map("registered_at")
  isActive     Boolean  @default(true) @map("is_active")

  // Relations
  userRoles          UserRole[]
  doctor             Doctor?
  patient            Patient?            @relation(name: "User")
  labTechnician     LabTechnician?
  receptionist       Receptionist?
  createdPatients    Patient[]           @relation(name: "Creator")
  createdDrugs       Drug[]              @relation(name: "DrugCreator")
  createdLabTests    LabTest[]           @relation(name: "LabTestCreator")
  walkinAppointments WalkinAppointment[] @relation(name: "WalkinAppointmentCreator")

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  roleId Int @map("role_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model StandardDepartment {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  code        String   @unique @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  departments Department[]

  @@map("standard_departments")
}

model Department {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique @db.VarChar(100)
  standardDepartmentId Int      @unique @map("standard_department_id")
  description          String?  @db.Text
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  standardDepartment StandardDepartment @relation(fields: [standardDepartmentId], references: [id])
  doctors            Doctor[]
  labTests           LabTest[]

  @@map("departments")
}

model Doctor {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  departmentId   Int      @map("department_id")
  licenseNumber  String   @unique @map("license_number") @db.VarChar(50)
  specialization String  @db.VarChar(100) @default("General Practitioner")
  experience     Int      @default(0)
  qualification  String  @db.VarChar(255) @default("MBBS")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department       @relation(fields: [departmentId], references: [id])
  schedules  DoctorSchedule[]

  @@map("doctors")
}

model Patient {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  dateOfBirth      DateTime? @map("date_of_birth")
  bloodGroup       String   @map("blood_group") @db.VarChar(5) @default("")
  address          String   @db.Text @default("")
  phoneNumber      String   @map("phone_number") @db.VarChar(15) @default("")
  emergencyContact String   @map("emergency_contact") @db.VarChar(15) @default("")
  medicalHistory   String   @map("medical_history") @db.Text @default("")
  familyHistory    String   @map("family_history") @db.Text @default("")
  allergies        String   @db.Text @default("")
  createdBy        Int?      @map("created_by") // User ID of the creator

  // Relations
  user         User          @relation(name: "User", fields: [userId], references: [id], onDelete: Cascade)
  creator      User?         @relation(name: "Creator", fields: [createdBy], references: [id], onDelete: SetNull)
  appointments Appointment[]
  labTests     PatientLabTest[]

  @@map("patients")
}

model Receptionist {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  phoneNumber String?  @map("phone_number") @db.VarChar(15)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("receptionists")
}

model LabTechnician {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  phoneNumber String?  @map("phone_number") @db.VarChar(15)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientLabTests PatientLabTest[]

  @@map("lab_technicians")
}

model Drug {
  id              Int    @id @default(autoincrement())
  name            String @unique @db.VarChar(255)
  formulaName     String @db.VarChar(255)
  chemicalFormula String @db.VarChar(255)
  strength        String @db.VarChar(100)
  dosageForm      String @db.VarChar(100)
  description     String @db.Text
  supplier        String @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")

  // Relations
  createdByUser User?        @relation(name: "DrugCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  medications   Medication[]
}

model LabTest {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  description  String? @db.Text
  departmentId Int     @map("department_id")

  templateId Int?    @map("template_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")

  // Relations
  createdByUser       User?                @relation(name: "LabTestCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  department          Department           @relation(fields: [departmentId], references: [id])
  recommendedLabTests RecommendedLabTest[]
  template            LabTestTemplate?     @relation(fields: [templateId], references: [id])
  patientLabTests     PatientLabTest[]
}

model DoctorSchedule {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctor_id")
  from      DateTime @map("start_time")
  to        DateTime @map("end_time")
  noOfSlots Int      @map("no_of_slots")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentSlots AppointmentSlot[]

  @@map("doctor_schedules")
}

model AppointmentSlot {
  id         Int      @id @default(autoincrement())
  scheduleId Int      @map("schedule_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  isBooked   Boolean  @default(false) @map("is_booked")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  schedule     DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@map("appointment_slots")
}

model Appointment {
  id        Int @id @default(autoincrement())
  patientId Int @map("patient_id")
  slotId    Int @map("slot_id")
  reason   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  slot              AppointmentSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  walkinAppointment WalkinAppointment?
  onlineAppointment OnlineAppointment?
  checkup           Checkup?

  @@map("appointments")
}

enum WalkinAppointmentStatus {
  BOOKED
  COMPLETED
  NOT_ATTENDED
}

model WalkinAppointment {
  id            Int    @id @default(autoincrement())
  appointmentId Int    @unique @map("appointment_id")
  status        WalkinAppointmentStatus @default(BOOKED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy Int @map("created_by")

  // Relations
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdByUser User        @relation(name: "WalkinAppointmentCreator", fields: [createdBy], references: [id], onDelete: Cascade)
}

enum OnlineAppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NOT_ATTENDED
}

model OnlineAppointment {
  id            Int    @id @default(autoincrement())
  appointmentId Int    @unique @map("appointment_id")
  status        OnlineAppointmentStatus @default(BOOKED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Checkup {
  id                          Int     @id @default(autoincrement())
  appointmentId               Int     @unique @map("appointment_id")
  bloodPressure               String? @map("blood_pressure") @db.VarChar(20)
  temperature                 String? @db.VarChar(20)
  heartRate                   String? @map("heart_rate") @db.VarChar(20)
  bloodSugar                  String? @map("blood_sugar") @db.VarChar(20)
  symptoms                    String  @db.Text
  diagnosis                   String  @db.Text
  notes                       String? @db.Text
  prescriptionId              Int     @unique @map("prescription_id")
  checkupTestRecommendationId Int     @unique @map("checkup_test_recommendation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  appointment               Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  prescription              Prescription              @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  checkupTestRecommendation CheckupTestRecommendation @relation(fields: [checkupTestRecommendationId], references: [id], onDelete: Cascade)
}

model Prescription {
  id Int @id @default(autoincrement())

  additionalMedications String? @map("additional_medications") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  checkup     Checkup?
  medications Medication[]
}

model Medication {
  id             Int     @id @default(autoincrement())
  drugId         Int     @map("drug_id")
  prescriptionId Int     @map("prescription_id")
  quantity       Int     @map("quantity")
  dosage         String  @db.VarChar(100)
  dailyFrequency Int  @map("daily_frequency")
  durationDays   Int     @map("duration_days")
  guidelines     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  drug         Drug         @relation(fields: [drugId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model CheckupTestRecommendation {
  id              Int     @id @default(autoincrement())
  additionalTests String? @map("additional_tests") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  recommendedLabTests RecommendedLabTest[]
  checkup             Checkup?
}

model RecommendedLabTest {
  id               Int @id @default(autoincrement())
  recommendationId Int @map("recommendation_id")
  labTestId        Int @map("lab_test_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  labTest        LabTest                   @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  recommendation CheckupTestRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}


model LabTestTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  version     String   @db.VarChar(50)
  formStructure Json  @map("form_structure")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([name, version])

  // Relations
  labTests LabTest[]
}

enum PatientLabTestStatus {
  PENDING
  COMPLETED
  CANCELLED
}
model PatientLabTest {
  id         Int      @id @default(autoincrement())
  patientId  Int      @map("patient_id")
  labTestId  Int      @map("lab_test_id")
  result     String?  @db.Text
  performedAt DateTime? @map("performed_at")
  status     PatientLabTestStatus @default(PENDING)

  labTechnicianAssigned Int? @map("lab_technician_assigned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labTest LabTest @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  labTechnician LabTechnician? @relation(fields: [labTechnicianAssigned], references: [id], onDelete: SetNull)

  @@map("patient_lab_tests")
}