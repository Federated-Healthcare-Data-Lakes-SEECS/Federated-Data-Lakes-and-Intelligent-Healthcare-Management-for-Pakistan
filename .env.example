# Environment variables for Docker Compose
# Copy this file to .env and update the values

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-here

# Database connection (using host.docker.internal to connect to host machine)
DATABASE_URL=postgresql://postgres:123@host.docker.internal:5433/hospital_db

# Optional: Override service URLs if needed
CHECKUP_MICROSERVICE_URL=http://checkups-microservice:3000
